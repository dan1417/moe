# sweep41 transient queue (scored recipes are saved as configs/merge/k41/<label>.json)
configs/merge/k41/queue/

# miner CLI venv and per-hotkey state (manifest, registration; the credential is removed at ready)
.venv-miner/
.teutonic-miner/
